# Application variables
PROJECT_NAME="AI Voice Interview Agent"
LOG_LEVEL="INFO"

# Database connection details (use postgresql+asyncpg for async SQLAlchemy)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/interview_agent"

# Security configurations
JWT_SECRET_KEY="SUPER_SECRET_JWT_KEY_CHANGE_THIS_IN_PRODUCTION_12345!"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Ollama / Groq / Multi-Model LLM settings
# Set your GROQ_API_KEY below for ultra-fast (<1s) evaluation and question generation
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
LLM_PROVIDER="auto"

# Task-Specific Model Allocations (Multi-Model Architecture)
PLANNER_MODEL="openai/gpt-oss-120b"
EVALUATOR_MODEL="openai/gpt-oss-120b"
INTERVIEWER_MODEL="openai/gpt-oss-20b"
REPORTER_MODEL="openai/gpt-oss-120b"

# Local Ollama Fallback Settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
MOCK_LLM=False

# Speech configuration (Whisper / Piper)
WHISPER_MODEL_PATH="base"
PIPER_MODEL_PATH="en_US-lessac-medium"
PIPER_VOICE="en_US-lessac-medium"
ENABLE_TTS=False
AUDIO_OUTPUT_DIR="./audio_outputs"
